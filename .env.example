# Optional live train-running provider configuration. Keep this key private on the backend.
# Obtain a key and confirm the provider's commercial terms before use.
RAILRADAR_API_KEY=put_your_provider_key_here

# Email OTP delivery through Gmail SMTP. Enable Google 2-Step Verification, then create a 16-character App Password.
# Copy this file to .env beside START_RAILBUS.bat. The server also accepts backend/.env.
# Put your real Gmail address in SMTP_USER and SMTP_FROM. SMTP_PASS is the 16-character Google App Password, NOT your normal Gmail password. Remove spaces from the App Password when entering it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM=yourgmail@gmail.com

# Protect the KSRTC operator/admin API. Use a long unique password.
RAILBUS_ADMIN_PASSWORD=change_this_to_a_long_unique_operator_password
